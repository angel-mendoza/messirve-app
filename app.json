{
  "expo": {
    "name": "Messirve",
    "slug": "messirve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-blue.png",
    "scheme": "messirveapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-blue.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "eu.messirve"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-blue.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Messirve necesita acceso a tu galería para cambiar tu foto de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e43078ff-5dde-426b-b89f-a79f7e12ec2f"
      }
    },
    "owner": "luis.onlife.dev"
  }
}
