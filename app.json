{
  "expo": {
    "name": "messirve-app",
    "slug": "messirve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-blue.png",
    "scheme": "messirveapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-blue.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.anonymous.messirveapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-blue.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Messirve necesita acceso a tu galería para cambiar tu foto de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6e10b25-02c1-4ae2-a4b3-8baf18e6b916"
      }
    },
    "owner": "crissdevs-organization"
  }
}
